#include "common.hpp"
#include <algorithm>
#include <cmath>
#include <cstring>
#include <iomanip>
#include <fstream>
#include <sstream>
#include <stdexcept>
#include <cfenv>
#include <limits>
#include <float.h>
#pragma fenv_access(on)

namespace t0common { namespace {
struct Rng { std::uint64_t x=0x6a09e667f3bcc909ULL; std::uint64_t next(){std::uint64_t z=(x+=0x9e3779b97f4a7c15ULL);z=(z^(z>>30))*0xbf58476d1ce4e5b9ULL;z=(z^(z>>27))*0x94d049bb133111ebULL;return z^(z>>31);} };
std::uint16_t f32half(float f){std::uint32_t x;std::memcpy(&x,&f,4);std::uint32_t sign=(x>>16)&0x8000, e=(x>>23)&255, m=x&0x7fffff;if(e==255)return static_cast<std::uint16_t>(sign|0x7c00|(m?0x200:0));int he=int(e)-112;if(he>=31)return static_cast<std::uint16_t>(sign|0x7c00);if(he<=0){if(he < -10)return sign;m|=0x800000;unsigned shift=14-he;return static_cast<std::uint16_t>(sign+((m+(1u<<(shift-1))-1+((m>>shift)&1))>>shift));}m+=0xfff+((m>>13)&1);if(m&0x800000){m=0;++he;if(he>=31)return static_cast<std::uint16_t>(sign|0x7c00);}return static_cast<std::uint16_t>(sign|(unsigned(he)<<10)|(m>>13));}
float half32(std::uint16_t h){unsigned s=h>>15,e=(h>>10)&31,m=h&1023;if(!e)return std::ldexp(float(m),-24)*(s?-1.f:1.f);if(e==31)return m?NAN:(s?-INFINITY:INFINITY);return (s?-1.f:1.f)*std::ldexp(1.f+float(m)/1024.f,int(e)-15);}
void put32(std::vector<std::uint8_t>& b,std::uint32_t v){for(int i=0;i<4;++i)b.push_back(std::uint8_t(v>>(i*8)));}
void put16(std::vector<std::uint8_t>& b,std::uint16_t v){b.push_back(std::uint8_t(v));b.push_back(std::uint8_t(v>>8));}
// Compact standalone SHA-256 over the canonical byte stream.
std::string sha256(const std::vector<std::uint8_t>& in){static const std::uint32_t K[64]={0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};std::vector<std::uint8_t>d=in;std::uint64_t bits=std::uint64_t(d.size())*8;d.push_back(128);while(d.size()%64!=56)d.push_back(0);for(int i=7;i>=0;--i)d.push_back(std::uint8_t(bits>>(i*8)));std::uint32_t h[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};auto rr=[](std::uint32_t x,int n){return(x>>n)|(x<<(32-n));};for(size_t off=0;off<d.size();off+=64){std::uint32_t w[64];for(int i=0;i<16;++i)w[i]=(std::uint32_t(d[off+4*i])<<24)|(std::uint32_t(d[off+4*i+1])<<16)|(std::uint32_t(d[off+4*i+2])<<8)|d[off+4*i+3];for(int i=16;i<64;++i){auto a=rr(w[i-15],7)^rr(w[i-15],18)^(w[i-15]>>3),b=rr(w[i-2],17)^rr(w[i-2],19)^(w[i-2]>>10);w[i]=w[i-16]+a+w[i-7]+b;}auto a=h[0],b=h[1],c=h[2],e=h[4],f=h[5],g=h[6],z=h[7],dd=h[3];for(int i=0;i<64;++i){auto t1=z+(rr(e,6)^rr(e,11)^rr(e,25))+((e&f)^(~e&g))+K[i]+w[i],t2=(rr(a,2)^rr(a,13)^rr(a,22))+((a&b)^(a&c)^(b&c));z=g;g=f;f=e;e=dd+t1;dd=c;c=b;b=a;a=t1+t2;}h[0]+=a;h[1]+=b;h[2]+=c;h[3]+=dd;h[4]+=e;h[5]+=f;h[6]+=g;h[7]+=z;}std::ostringstream s;s<<std::hex<<std::setfill('0');for(auto x:h)s<<std::setw(8)<<x;return s.str();}
std::vector<std::uint8_t> canonical(const Cell& c){std::vector<std::uint8_t>b;const char magic[]="T0P-CELL-v1";b.insert(b.end(),magic,magic+sizeof(magic)-1);put32(b,O);put32(b,I);put32(b,c.M);put32(b,unsigned(c.fixture));for(auto q:c.wq)b.push_back(std::uint8_t(q));for(auto h:c.ws_half)put16(b,h);for(auto q:c.xq)b.push_back(std::uint8_t(q));for(auto h:c.xs_half)put16(b,h);return b;}
}
const char* fixture_name(Fixture f){switch(f){case Fixture::Uniform:return"uniform";case Fixture::MixedCancellation:return"mixed_cancellation";case Fixture::VariedScales:return"varied_scales";case Fixture::Sub127:return"sub127";case Fixture::Extremes:return"extremes";case Fixture::ZeroInput:return"zero_input";case Fixture::SingleCoordinate:return"single_coordinate";case Fixture::CancellationHigh:return"cancellation_high";case Fixture::CancellationExtreme:return"cancellation_extreme";case Fixture::ExactCancellation:return"cancellation_exact_groups";default:return"invalid";}}
Cell generate(int M,Fixture f){if(M!=1&&M!=4&&M!=8&&M!=16)throw std::invalid_argument("M must be 1,4,8,16");Cell c;c.M=M;c.fixture=f;c.wq.resize(O*I);c.xq.resize(M*I);c.ws_half.resize(O*G);c.xs_half.resize(M*G);Rng r; r.x^=(std::uint64_t(M)<<24)^(std::uint64_t(f)<<40);for(auto&q:c.wq)q=std::int8_t(int(r.next()%15)-7);for(auto&q:c.xq)q=std::int8_t(int(r.next()%255)-127);
if(f==Fixture::MixedCancellation){for(int o=0;o<O;++o)for(int g=0;g<G;++g)for(int k=0;k<32;++k)c.wq[o*I+g*32+k]=std::int8_t((g&1)?-5:5);for(int m=0;m<M;++m)for(int i=0;i<I;++i)c.xq[m*I+i]=std::int8_t((i&1)?-11:11);}
if(f==Fixture::ZeroInput)std::fill(c.xq.begin(),c.xq.end(),0);
if(f==Fixture::SingleCoordinate){std::fill(c.xq.begin(),c.xq.end(),0);for(int m=0;m<M;++m)c.xq[m*I]=1;}
if(f==Fixture::CancellationHigh||f==Fixture::CancellationExtreme){for(int o=0;o<O;++o){std::fill(c.wq.begin()+o*I,c.wq.begin()+(o+1)*I,0);for(int k=0;k<32;++k){c.wq[o*I+k]=7;c.wq[o*I+32+k]=-7;}}for(auto&q:c.xq)q=127;}
if(f==Fixture::CancellationExtreme){for(int o=0;o<O;++o)c.wq[o*I+64]=1;for(int m=0;m<M;++m)c.xq[m*I+64]=1;}
if(f==Fixture::ExactCancellation){for(int o=0;o<O;++o){std::fill(c.wq.begin()+o*I,c.wq.begin()+(o+1)*I,0);for(int k=0;k<32;++k){c.wq[o*I+k]=7;c.wq[o*I+32+k]=-7;}}for(int m=0;m<M;++m){std::fill(c.xq.begin()+m*I,c.xq.begin()+(m+1)*I,0);for(int k=0;k<64;++k)c.xq[m*I+k]=127;}}
if(f==Fixture::Sub127)for(size_t i=0;i<c.xq.size();++i)c.xq[i]=std::int8_t(int(r.next()%81)-40);
if(f==Fixture::Extremes){for(int o=0;o<O;++o)for(int i=0;i<I;++i)c.wq[o*I+i]=std::int8_t(i%2?7:-8);for(int m=0;m<M;++m)for(int i=0;i<I;++i)c.xq[m*I+i]=std::int8_t(i%2?127:-127);}
for(int o=0;o<O;++o)for(int g=0;g<G;++g){float s=f==Fixture::VariedScales?(0.13f+float((o*19+g*7)%113)/71.f):(0.25f+float(r.next()%100)/97.f);auto h=f32half(s);c.ws_half[o*G+g]=h;}
for(int m=0;m<M;++m)for(int g=0;g<G;++g){float s=f==Fixture::VariedScales?(0.19f+float((m*31+g*13)%89)/53.f):(0.3f+float(r.next()%100)/101.f);auto h=f32half(s);c.xs_half[m*G+g]=h;}
if(f==Fixture::ZeroInput||f==Fixture::SingleCoordinate||f==Fixture::CancellationHigh||f==Fixture::CancellationExtreme||f==Fixture::ExactCancellation){std::fill(c.ws_half.begin(),c.ws_half.end(),0x3c00);std::fill(c.xs_half.begin(),c.xs_half.end(),0x3c00);}
if(f==Fixture::CancellationHigh)for(int m=0;m<M;++m)c.xs_half[m*G+1]=0x3c01;
if(f==Fixture::CancellationExtreme)for(int m=0;m<M;++m)c.xs_half[m*G+2]=0x0001;
c.ws.resize(c.ws_half.size());for(size_t i=0;i<c.ws.size();++i)c.ws[i]=half32(c.ws_half[i]);c.xs.resize(c.xs_half.size());for(size_t i=0;i<c.xs.size();++i)c.xs[i]=half32(c.xs_half[i]);c.sha256=sha256(canonical(c));return c;}
Cell generate_single_coordinate(int M,int coordinate){if(coordinate<0||coordinate>=I)throw std::invalid_argument("single-coordinate index out of range");Cell c=generate(M,Fixture::SingleCoordinate);std::fill(c.xq.begin(),c.xq.end(),0);for(int m=0;m<M;++m)c.xq[m*I+coordinate]=1;c.sha256=sha256(canonical(c));return c;}
void save_cell(const Cell&c,const std::filesystem::path&p){auto b=canonical(c);std::ofstream f(p,std::ios::binary|std::ios::trunc);if(!f||!f.write(reinterpret_cast<const char*>(b.data()),std::streamsize(b.size())))throw std::runtime_error("cannot write canonical cell: "+p.string());}
Cell load_cell(const std::filesystem::path&p){std::ifstream f(p,std::ios::binary);if(!f)throw std::runtime_error("cannot open canonical cell: "+p.string());std::vector<std::uint8_t>b((std::istreambuf_iterator<char>(f)),{});const std::string magic="T0P-CELL-v1";size_t at=magic.size();if(b.size()<at+16||!std::equal(magic.begin(),magic.end(),b.begin()))throw std::runtime_error("bad canonical cell header");auto u32=[&](){if(at+4>b.size())throw std::runtime_error("truncated cell");std::uint32_t v=0;for(int i=0;i<4;++i)v|=std::uint32_t(b[at++])<<(8*i);return v;};auto u16=[&](){if(at+2>b.size())throw std::runtime_error("truncated cell");std::uint16_t v=b[at]|(std::uint16_t(b[at+1])<<8);at+=2;return v;};if(u32()!=O||u32()!=I)throw std::runtime_error("canonical dimensions mismatch");Cell c;c.M=int(u32());c.fixture=Fixture(u32());if((c.M!=1&&c.M!=4&&c.M!=8&&c.M!=16)||unsigned(c.fixture)>=unsigned(Fixture::Count))throw std::runtime_error("canonical metadata invalid");size_t wn=size_t(O)*I,xn=size_t(c.M)*I,wsn=size_t(O)*G,xsn=size_t(c.M)*G;if(at+wn>b.size())throw std::runtime_error("truncated weights");c.wq.resize(wn);for(auto&q:c.wq)q=std::int8_t(b[at++]);c.ws_half.resize(wsn);for(auto&h:c.ws_half)h=u16();if(at+xn>b.size())throw std::runtime_error("truncated activations");c.xq.resize(xn);for(auto&q:c.xq)q=std::int8_t(b[at++]);c.xs_half.resize(xsn);for(auto&h:c.xs_half)h=u16();if(at!=b.size())throw std::runtime_error("trailing canonical cell bytes");c.ws.resize(wsn);for(size_t i=0;i<wsn;++i)c.ws[i]=half32(c.ws_half[i]);c.xs.resize(xsn);for(size_t i=0;i<xsn;++i)c.xs[i]=half32(c.xs_half[i]);c.sha256=sha256(b);return c;}
namespace {
double gamma_n(int n,double u){return (double(n)*u)/(1.0-double(n)*u);}
int control_round(int mode){switch(mode){case FE_TONEAREST:return _RC_NEAR;case FE_DOWNWARD:return _RC_DOWN;case FE_UPWARD:return _RC_UP;case FE_TOWARDZERO:return _RC_CHOP;default:throw std::runtime_error("unsupported FP rounding mode");}}
template<class F> double directed(int mode,F op){
 int saved=std::fegetround(); if(saved==-1)throw std::runtime_error("fegetround failed before directed operation");
 unsigned int saved_control=0; if(_controlfp_s(&saved_control,0,0)!=0)throw std::runtime_error("_controlfp_s read failed");
 auto restore=[&](){int fs=std::fesetround(saved);unsigned int ignored=0;unsigned int cs=_controlfp_s(&ignored,saved_control&_MCW_RC,_MCW_RC);unsigned int observed=0;unsigned int rs=_controlfp_s(&observed,0,0);return fs==0&&cs==0&&rs==0&&std::fegetround()==saved&&(observed&_MCW_RC)==(saved_control&_MCW_RC);};
 volatile double result=0.0;
 try {
  if(std::fesetround(mode)!=0)throw std::runtime_error("fesetround change failed");
  unsigned int ignored=0; if(_controlfp_s(&ignored,(unsigned int)control_round(mode),_MCW_RC)!=0)throw std::runtime_error("_controlfp_s change failed");
  if(std::fegetround()!=mode)throw std::runtime_error("directed rounding change did not take effect");
  unsigned int observed=0; if(_controlfp_s(&observed,0,0)!=0||(observed&_MCW_RC)!=(unsigned int)control_round(mode))throw std::runtime_error("_controlfp_s directed mode mismatch");
  result=op();
 } catch(...) {if(!restore())throw std::runtime_error("failed to restore FP environment after directed operation failure");throw;}
 if(!restore())throw std::runtime_error("failed to restore FP rounding mode");
 return result;
}double up_add(double a,double b){return directed(FE_UPWARD,[&](){return a+b;});}
double up_mul(double a,double b){return directed(FE_UPWARD,[&](){return a*b;});}
double up_div(double a,double b){return directed(FE_UPWARD,[&](){return a/b;});}
double down_sub(double a,double b){return directed(FE_DOWNWARD,[&](){return a-b;});}
double up_sub(double a,double b){return directed(FE_UPWARD,[&](){return a-b;});}
double gamma_up(int n,double u){double nu=up_mul(double(n),u);return up_div(nu,down_sub(1.0,nu));}
double up_abs_diff(double a,double b){double d=up_sub(a,b),nd=up_sub(b,a);return std::max(d,nd);}
void validate(const Cell&c){if(c.M!=1&&c.M!=4&&c.M!=8&&c.M!=16)throw std::invalid_argument("invalid M");if(c.wq.size()!=size_t(O)*I||c.xq.size()!=size_t(c.M)*I||c.ws_half.size()!=size_t(O)*G||c.xs_half.size()!=size_t(c.M)*G||c.ws.size()!=c.ws_half.size()||c.xs.size()!=c.xs_half.size())throw std::invalid_argument("inconsistent cell dimensions/sizes");for(auto q:c.wq)if(q < -8||q>7)throw std::invalid_argument("Q4 code outside [-8,7]");for(auto q:c.xq)if(q==-128)throw std::invalid_argument("INT8 code -128 invalid");for(size_t i=0;i<c.ws_half.size();++i)if(((c.ws_half[i]>>10)&31)==31||!std::isfinite(c.ws[i])||c.ws[i]!=half32(c.ws_half[i]))throw std::invalid_argument("invalid or desynchronized FP16 weight scale");for(size_t i=0;i<c.xs_half.size();++i)if(((c.xs_half[i]>>10)&31)==31||!std::isfinite(c.xs[i])||c.xs[i]!=half32(c.xs_half[i]))throw std::invalid_argument("invalid or desynchronized FP16 activation scale");}
}
Ref64 reference64(const Cell&c){validate(c);Ref64 z;size_t n=size_t(c.M)*O;z.r64.resize(n);z.S.resize(n);z.Splus.resize(n);z.B.resize(n);const double u64=std::ldexp(1.0,-53),u32=std::ldexp(1.0,-24);double g514_64=gamma_up(514,u64),g18_64=gamma_up(18,u64),g514_32=gamma_up(514,u32);
 for(int m=0;m<c.M;++m)for(int o=0;o<O;++o){double sum=0,shat=0;for(int g=0;g<G;++g){std::int32_t dot=0;for(int k=0;k<32;++k)dot+=int(c.wq[o*I+g*32+k])*int(c.xq[m*I+g*32+k]);double scale=double(c.ws[o*G+g])*double(c.xs[m*G+g]);sum+=double(dot)*scale;
   for(int k=0;k<32;++k){double term=(double(c.wq[o*I+g*32+k])*double(c.ws[o*G+g]))*(double(c.xq[m*I+g*32+k])*double(c.xs[m*G+g]));shat+=std::abs(term);}}
 size_t ix=size_t(m)*O+o;z.r64[ix]=sum;z.S[ix]=shat;z.Splus[ix]=up_div(shat,down_sub(1.0,g514_64));z.B[ix]=up_mul(up_add(g514_32,g18_64),z.Splus[ix]);if(!std::isfinite(sum)||!std::isfinite(shat)||!std::isfinite(z.Splus[ix])||!std::isfinite(z.B[ix]))throw std::runtime_error("non-finite reference/S/B");}return z;}
std::vector<float> reference(const Cell&c){auto r=reference64(c);std::vector<float> y(r.r64.size());for(size_t i=0;i<y.size();++i)y[i]=float(r.r64[i]);return y;}
S12Verification verify_s12(const Cell&c,const std::vector<float>&out){auto r=reference64(c);S12Verification v;v.pass=true;if(out.size()!=r.r64.size()){v.pass=false;v.failures=out.size()>r.r64.size()?out.size()-r.r64.size():r.r64.size()-out.size();return v;}
 for(size_t i=0;i<out.size();++i){double y=out[i],d=up_abs_diff(y,r.r64[i]);bool pass=std::isfinite(y)&&std::isfinite(d)&&std::isfinite(r.r64[i]);if(r.S[i]==0.0)pass=pass&&(y==0.0);else pass=pass&&(d<=r.B[i]);if(pass){if(r.B[i]>0)v.max_error_over_B=std::max(v.max_error_over_B,d/r.B[i]);continue;}Failure f;f.m=int(i/O);f.o=int(i%O);f.r64=r.r64[i];f.y=y;f.error=d;f.S=r.S[i];f.B=r.B[i];f.error_over_B=r.B[i]?d/r.B[i]:std::numeric_limits<double>::infinity();f.S_over_abs_r=r.r64[i]!=0?r.S[i]/std::abs(r.r64[i]):std::numeric_limits<double>::infinity();v.failed.push_back(f);++v.failures;v.pass=false;}return v;}
Verification verify(const Cell&c,const std::vector<float>&out){Verification v;auto ref=reference(c);if(out.size()!=ref.size()){v.failures=out.size()>ref.size()?out.size()-ref.size():ref.size()-out.size();return v;}for(float x:c.ws)if(!std::isfinite(x))++v.failures;for(float x:c.xs)if(!std::isfinite(x))++v.failures;for(auto q:c.wq)if(q < -8 || q > 7)++v.failures;for(size_t i=0;i<ref.size();++i){double a=out[i],b=ref[i],e=std::abs(a-b);if(!std::isfinite(b)||!std::isfinite(a)||!std::isfinite(e)){++v.failures;continue;}double tol=1e-5+1e-5*std::abs(b);v.max_abs=std::max(v.max_abs,e);if(b!=0.0)v.max_rel=std::max(v.max_rel,e/std::abs(b));if(e>tol)++v.failures;}v.pass=v.failures==0;return v;}
void directed_tests(){
 const int incoming=std::fegetround(); if(incoming==-1)throw std::runtime_error("cannot read incoming kernel rounding mode");
 volatile double one=1.0, half53=std::ldexp(1.0,-53), half54=std::ldexp(1.0,-54), a=1.0+std::ldexp(1.0,-27), b=1.0-std::ldexp(1.0,-27), ten=10.0;
 double add_up=directed(FE_UPWARD,[&](){return one+half53;}), add_down=directed(FE_DOWNWARD,[&](){return one+half53;});
 double sub_up=directed(FE_UPWARD,[&](){return one-half54;}), sub_down=directed(FE_DOWNWARD,[&](){return one-half54;});
 double mul_up=directed(FE_UPWARD,[&](){return a*b;}), mul_down=directed(FE_DOWNWARD,[&](){return a*b;});
 double div_up=directed(FE_UPWARD,[&](){return one/ten;}), div_down=directed(FE_DOWNWARD,[&](){return one/ten;});
 if(add_up!=std::nextafter(1.0,2.0)||add_down!=1.0||sub_up!=1.0||sub_down!=std::nextafter(1.0,0.0)||mul_up!=1.0||mul_down!=std::nextafter(1.0,0.0)||!(div_down<div_up)||std::fegetround()!=incoming)throw std::runtime_error("runtime directed arithmetic or restoration test failed");
 volatile double kernel_probe=one+half53; if(std::fegetround()!=incoming||(incoming==FE_TONEAREST&&kernel_probe!=1.0))throw std::runtime_error("kernel FP environment was not restored to caller mode");
 auto c=generate(1,Fixture::Uniform);auto ref=reference64(c);for(int o=0;o<O;++o){long double exact_s=0;for(int j=0;j<I;++j){int g=j/32;long double t=(long double)c.wq[o*I+j]*(long double)c.ws[o*G+g]*(long double)c.xq[j]*(long double)c.xs[g];exact_s+=std::fabs(t);}long double u32=std::ldexp((long double)1,-24),u64=std::ldexp((long double)1,-53);long double exact_b=((514*u32)/(1-514*u32)+(18*u64)/(1-18*u64))*exact_s/(1-(514*u64)/(1-514*u64));if((long double)ref.B[o]<exact_b)throw std::runtime_error("computed B is below higher-precision bound");}
}
void verifier_unit_tests(){directed_tests();auto c=generate(1,Fixture::Uniform);auto y=reference(c);if(!verify(c,y).pass||!verify_s12(c,y).pass)throw std::runtime_error("valid verifier unit failed");auto z=y;z[0]=NAN;if(verify_s12(c,z).pass||s12_compare(0,1,1,NAN))throw std::runtime_error("NaN was accepted");z=y;z[0]=INFINITY;if(verify_s12(c,z).pass||s12_compare(0,1,1,INFINITY))throw std::runtime_error("Inf was accepted");z=y;z[0]+=float(2e-5+2e-5*std::abs(double(y[0])));if(verify(c,z).pass)throw std::runtime_error("old diagnostic tolerance test failed");if(!s12_compare(0,1,1.0,1.0)||!s12_compare(0,1,1.0,-1.0)||s12_compare(0,1,1.0,std::nextafter(1.0,2.0))||s12_compare(0,1,1.0,std::nextafter(-1.0,-2.0)))throw std::runtime_error("S12 boundary test failed");if(!s12_compare(0,0,0,-0.0)||s12_compare(0,0,0,std::numeric_limits<double>::denorm_min()))throw std::runtime_error("S=0 exact-zero test failed");if(s12_compare(0,1,1,std::numeric_limits<double>::infinity()))throw std::runtime_error("Inf comparator test failed");auto shortout=y;shortout.pop_back();if(verify_s12(c,shortout).pass)throw std::runtime_error("size mismatch accepted");auto zero=generate(1,Fixture::ZeroInput);auto inverse=[&](std::vector<std::int8_t>&w,std::vector<std::uint16_t>&ws,std::vector<std::int8_t>&x,std::vector<std::uint16_t>&xs){w=zero.wq;ws=zero.ws_half;x=zero.xq;xs=zero.xs_half;return true;};if(!exact_representation(zero,inverse))throw std::runtime_error("representation baseline failed");if(exact_representation(zero,[&](auto&w,auto&ws,auto&x,auto&xs){inverse(w,ws,x,xs);w[0]^=1;return true;}))throw std::runtime_error("negative code mutation was not detected");if(exact_representation(zero,[&](auto&w,auto&ws,auto&x,auto&xs){inverse(w,ws,x,xs);ws[0]^=1;return true;}))throw std::runtime_error("negative scale mutation was not detected");if(!exact_group_dots(zero,[&](std::vector<std::int32_t>&dots){dots.resize(size_t(zero.M)*O*G);for(int m=0;m<zero.M;++m)for(int o=0;o<O;++o)for(int g=0;g<G;++g){std::int32_t d=0;for(int k=0;k<32;++k)d+=int(zero.wq[o*I+g*32+k])*int(zero.xq[m*I+g*32+k]);dots[(size_t(m)*O+o)*G+g]=d;}return true;}))throw std::runtime_error("exact group-dot API baseline failed");if(exact_group_dots(zero,[&](std::vector<std::int32_t>&dots){dots.assign(size_t(zero.M)*O*G,1);return true;}))throw std::runtime_error("exact group-dot mismatch was accepted");}
std::vector<std::uint8_t> omega_q4_18(const Cell&c){std::vector<std::uint8_t>b(size_t(O)*G*18);for(int o=0;o<O;++o)for(int g=0;g<G;++g){size_t dst=(size_t(o)*G+g)*18;for(int k=0;k<32;k+=2)b[dst+k/2]=std::uint8_t((unsigned(c.wq[o*I+g*32+k])&15)|((unsigned(c.wq[o*I+g*32+k+1])&15)<<4));b[dst+16]=std::uint8_t(c.ws_half[o*G+g]);b[dst+17]=std::uint8_t(c.ws_half[o*G+g]>>8);}return b;}
std::vector<std::uint8_t> ggml_q4_0(const Cell&c){std::vector<std::uint8_t>b(size_t(O)*G*18);for(int o=0;o<O;++o)for(int g=0;g<G;++g){size_t d=(size_t(o)*G+g)*18,s=d; b[d]=std::uint8_t(c.ws_half[o*G+g]);b[d+1]=std::uint8_t(c.ws_half[o*G+g]>>8);for(int j=0;j<16;++j)b[d+2+j]=std::uint8_t((unsigned(c.wq[o*I+g*32+j]+8))|((unsigned(c.wq[o*I+g*32+j+16]+8))<<4));}return b;}
std::vector<std::uint8_t> ggml_q8_0(const Cell&c){std::vector<std::uint8_t>b(size_t(c.M)*G*34);for(int m=0;m<c.M;++m)for(int g=0;g<G;++g){size_t d=(size_t(m)*G+g)*34;b[d]=std::uint8_t(c.xs_half[m*G+g]);b[d+1]=std::uint8_t(c.xs_half[m*G+g]>>8);for(int k=0;k<32;++k)b[d+2+k]=std::uint8_t(c.xq[m*I+g*32+k]);}return b;}
bool s12_compare(double r64,double S,double B,double y){if(!std::isfinite(r64)||!std::isfinite(S)||!std::isfinite(B)||!std::isfinite(y)||S<0||B<0)return false;double e=up_abs_diff(y,r64);if(!std::isfinite(e))return false;if(S==0)return y==0.0;return e<=B;}
bool exact_representation(const Cell&c,const std::function<bool(std::vector<std::int8_t>&,std::vector<std::uint16_t>&,std::vector<std::int8_t>&,std::vector<std::uint16_t>&)>& inverse){validate(c);std::vector<std::int8_t>w,x;std::vector<std::uint16_t>ws,xs;if(!inverse(w,ws,x,xs))return false;return w==c.wq&&x==c.xq&&ws==c.ws_half&&xs==c.xs_half;}
bool exact_group_dots(const Cell&c,const std::function<bool(std::vector<std::int32_t>&)>& route){validate(c);std::vector<std::int32_t> got;if(!route(got))return false;if(got.size()!=size_t(c.M)*O*G)return false;for(int m=0;m<c.M;++m)for(int o=0;o<O;++o)for(int g=0;g<G;++g){std::int32_t dot=0;for(int k=0;k<32;++k)dot+=int(c.wq[o*I+g*32+k])*int(c.xq[m*I+g*32+k]);if(got[(size_t(m)*O+o)*G+g]!=dot)return false;}return true;}
}
