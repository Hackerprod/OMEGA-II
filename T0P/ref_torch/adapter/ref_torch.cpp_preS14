static std::set<std::string> ops;
static bool large_page_privilege=false;
struct CandidateStats{double abs=0,rel=0,error_over_B=0;std::size_t failed_fixtures=0,cells=0;};
static std::unique_ptr<at::ObserverContext> on_op(const at::RecordFunction& f){ops.insert(f.name());return nullptr;}
static std::string env(const char* n){char* p=nullptr;size_t z=0;if(_dupenv_s(&p,&z,n)||!p)return "UNSET";std::string s(p);free(p);return s;}
static std::string file_sha256(const wchar_t* path){BCRYPT_ALG_HANDLE alg=nullptr;BCRYPT_HASH_HANDLE hash=nullptr;if(BCryptOpenAlgorithmProvider(&alg,BCRYPT_SHA256_ALGORITHM,nullptr,0)<0)return"HASH_ERROR";DWORD objlen=0,cb=0;BCryptGetProperty(alg,BCRYPT_OBJECT_LENGTH,(PUCHAR)&objlen,sizeof(objlen),&cb,0);std::vector<UCHAR>obj(objlen),out(32),buf(1<<16);if(BCryptCreateHash(alg,&hash,obj.data(),objlen,nullptr,0,0)<0){BCryptCloseAlgorithmProvider(alg,0);return"HASH_ERROR";}std::ifstream f(path,std::ios::binary);while(f){f.read((char*)buf.data(),buf.size());auto n=f.gcount();if(n>0&&BCryptHashData(hash,buf.data(),(ULONG)n,0)<0)break;}BCryptFinishHash(hash,out.data(),ULONG(out.size()),0);BCryptDestroyHash(hash);BCryptCloseAlgorithmProvider(alg,0);std::ostringstream s;s<<std::hex<<std::setfill('0');for(auto x:out)s<<std::setw(2)<<unsigned(x);return s.str();}
static void report_loaded_modules(){std::vector<HMODULE>mods(4096);DWORD needed=0;if(!EnumProcessModules(GetCurrentProcess(),mods.data(),DWORD(mods.size()*sizeof(HMODULE)),&needed)){std::cout<<"module_inventory=ERROR code="<<GetLastError()<<"\n";return;}mods.resize(needed/sizeof(HMODULE));std::sort(mods.begin(),mods.end());mods.erase(std::unique(mods.begin(),mods.end()),mods.end());for(auto m:mods){wchar_t path[32768]{};DWORD n=GetModuleFileNameExW(GetCurrentProcess(),m,path,DWORD(std::size(path)));if(!n)continue;std::wstring ws(path,n);std::string p(ws.begin(),ws.end());MODULEINFO mi{};GetModuleInformation(GetCurrentProcess(),m,&mi,sizeof(mi));WIN32_FILE_ATTRIBUTE_DATA ad{};ULARGE_INTEGER size{};if(GetFileAttributesExW(path,GetFileExInfoStandard,&ad))size.HighPart=ad.nFileSizeHigh,size.LowPart=ad.nFileSizeLow;std::cout<<"loaded_module path="<<p<<" image_bytes="<<mi.SizeOfImage<<" file_bytes="<<size.QuadPart<<" sha256="<<file_sha256(path)<<"\n";}std::cout<<"module_count="<<mods.size()<<"\n";}
static void configure(){_putenv_s("OMP_NUM_THREADS","1");_putenv_s("MKL_NUM_THREADS","1");_putenv_s("OMP_DYNAMIC","FALSE");_putenv_s("MKL_DYNAMIC","FALSE");at::set_num_threads(1);at::set_num_interop_threads(1);auto& c=at::globalContext();c.setFloat32Precision(at::Float32Backend::GENERIC,at::Float32Op::ALL,at::Float32Precision::IEEE);c.setFloat32Precision(at::Float32Backend::MKLDNN,at::Float32Op::MATMUL,at::Float32Precision::IEEE);c.setFloat32Precision(at::Float32Backend::CUDA,at::Float32Op::MATMUL,at::Float32Precision::IEEE);c.setAllowTF32OneDNN(false);c.setAllowTF32CuBLAS(false);c.setAllowTF32CuDNN(false);c.setAllowFP16ReductionCuBLAS(false,false);c.setAllowBF16ReductionCuBLAS(false,false);c.setAllowFP16AccumulationCuBLAS(false);c.setAllowFP16ReductionCPU(false);at::autocast::set_autocast_enabled(at::kCPU,false);at::autocast::set_autocast_enabled(at::kCUDA,false);}
static at::Tensor tensor(const std::vector<float>&v,std::vector<int64_t> shape){return at::from_blob(const_cast<float*>(v.data()),shape,at::TensorOptions().dtype(at::kFloat).device(at::kCPU)).clone();}
static bool check_large_page_privilege(){HANDLE token=nullptr;if(!OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY|TOKEN_ADJUST_PRIVILEGES,&token)){std::cout<<"LARGE_PAGE_PRIVILEGE=HOLD OpenProcessToken_error="<<GetLastError()<<"\n";return false;}LUID luid{};if(!LookupPrivilegeValueW(nullptr,L"SeLockMemoryPrivilege",&luid)){std::cout<<"LARGE_PAGE_PRIVILEGE=HOLD LookupPrivilegeValue_error="<<GetLastError()<<"\n";CloseHandle(token);return false;}DWORD n=0;GetTokenInformation(token,TokenPrivileges,nullptr,0,&n);std::vector<uint8_t>b(n);if(!GetTokenInformation(token,TokenPrivileges,b.data(),n,&n)){std::cout<<"LARGE_PAGE_PRIVILEGE=HOLD GetTokenInformation_error="<<GetLastError()<<"\n";CloseHandle(token);return false;}auto*tp=reinterpret_cast<TOKEN_PRIVILEGES*>(b.data());bool present=false;for(DWORD i=0;i<tp->PrivilegeCount;++i)if(tp->Privileges[i].Luid.LowPart==luid.LowPart&&tp->Privileges[i].Luid.HighPart==luid.HighPart)present=true;if(!present){std::cout<<"LARGE_PAGE_PRIVILEGE=HOLD SeLockMemoryPrivilege absent from token; no policy changes; normal allocation\n";CloseHandle(token);return false;}TOKEN_PRIVILEGES enable{};enable.PrivilegeCount=1;enable.Privileges[0].Luid=luid;enable.Privileges[0].Attributes=SE_PRIVILEGE_ENABLED;SetLastError(ERROR_SUCCESS);BOOL ok=AdjustTokenPrivileges(token,FALSE,&enable,sizeof(enable),nullptr,nullptr);DWORD err=GetLastError();CloseHandle(token);bool allowed=ok&&err!=ERROR_NOT_ALL_ASSIGNED;std::cout<<"LARGE_PAGE_PRIVILEGE="<<(allowed?"AVAILABLE":"HOLD")<<" AdjustTokenPrivileges_ok="<<ok<<" last_error="<<err<<"\n";return allowed;}
static bool report_buffer(const char*name,const at::Tensor&t){auto p=reinterpret_cast<std::uintptr_t>(t.data_ptr());MEMORY_BASIC_INFORMATION mbi{};VirtualQuery(reinterpret_cast<void*>(p),&mbi,sizeof(mbi));SYSTEM_INFO si{};GetSystemInfo(&si);const uintptr_t page=si.dwPageSize,start=p&~(page-1),end=(p+t.nbytes()+page-1)&~(page-1);std::vector<PSAPI_WORKING_SET_EX_INFORMATION> ws;for(uintptr_t q=start;q<end;q+=page){PSAPI_WORKING_SET_EX_INFORMATION item{};item.VirtualAddress=reinterpret_cast<void*>(q);ws.push_back(item);}BOOL q=!ws.empty()&&QueryWorkingSetEx(GetCurrentProcess(),ws.data(),DWORD(ws.size()*sizeof(ws[0])));size_t large=0,valid=0;if(q)for(const auto& item:ws){large+=item.VirtualAttributes.LargePage!=0;valid+=item.VirtualAttributes.Valid!=0;}std::cout<<"buffer="<<name<<" effective_ptr=0x"<<std::hex<<p<<std::dec<<" bytes="<<t.nbytes()<<" align64="<<(p%64==0)<<" page_base=0x"<<std::hex<<reinterpret_cast<std::uintptr_t>(mbi.BaseAddress)<<std::dec<<" region_bytes="<<mbi.RegionSize<<" state="<<mbi.State<<" type="<<mbi.Type<<" page_protect=0x"<<std::hex<<mbi.Protect<<" allocation_protect=0x"<<mbi.AllocationProtect<<std::dec<<" allocation_base=0x"<<std::hex<<reinterpret_cast<std::uintptr_t>(mbi.AllocationBase)<<std::dec<<" queried_pages="<<ws.size()<<" valid_pages="<<valid<<" large_pages="<<large<<" QueryWorkingSetEx="<<(q?"PASS":"FAIL")<<" LargePage="<<(large==ws.size()?"true":"false")<<" allocation_policy=effective_clone privilege="<<(large_page_privilege?"available_but_not_used":"HOLD_SeLockMemoryPrivilege_absent")<<"\n";return q!=FALSE&&valid==ws.size();}
static std::vector<float> unpack_weights(const t0common::Cell&c,bool trans){std::vector<float>v(size_t(t0common::O)*t0common::I);for(int o=0;o<t0common::O;++o)for(int i=0;i<t0common::I;++i)v[trans?size_t(i)*t0common::O+o:size_t(o)*t0common::I+i]=float(c.wq[o*t0common::I+i])*c.ws[o*t0common::G+i/32];return v;}
static at::Tensor run_candidate(const std::string&name,const at::Tensor&X,const at::Tensor&W,const at::Tensor&Wt,const at::Tensor&Xd,const at::Tensor&Wd,int M){
 if(name=="mm")return at::mm(X,Wt);if(name=="matmul")return at::matmul(X,Wt);if(name=="linear")return at::linear(X,W,std::optional<at::Tensor>());if(name=="mkldnn_linear")return at::mkldnn_linear(Xd,Wd,std::optional<at::Tensor>());
 return at::mv(W,X[0]).unsqueeze(0);
}
static bool exact_group_dot_isolation(){
 const std::vector<t0common::Fixture> fixtures={t0common::Fixture::Uniform,t0common::Fixture::MixedCancellation,t0common::Fixture::VariedScales,t0common::Fixture::Sub127,t0common::Fixture::Extremes};
 std::map<std::string,std::size_t> checks,failures;std::vector<std::string> names={"mm","matmul","linear","mv"};
 for(int M:{1,4,8,16})for(auto fixture:fixtures){auto base=t0common::generate(M,fixture);for(int g=0;g<t0common::G;++g){auto c=base;std::fill(c.ws_half.begin(),c.ws_half.end(),0x3c00);std::fill(c.xs_half.begin(),c.xs_half.end(),0x3c00);std::fill(c.ws.begin(),c.ws.end(),1.0f);std::fill(c.xs.begin(),c.xs.end(),1.0f);for(int m=0;m<M;++m)for(int j=0;j<t0common::I;++j)if(j/32!=g)c.xq[m*t0common::I+j]=0;std::vector<float>xv(size_t(M)*t0common::I);for(int m=0;m<M;++m)for(int j=0;j<t0common::I;++j)xv[m*t0common::I+j]=float(c.xq[m*t0common::I+j]);auto X=tensor(xv,{M,t0common::I});auto wv=unpack_weights(c,false),wtv=unpack_weights(c,true);auto W=tensor(wv,{t0common::O,t0common::I}),Wt=tensor(wtv,{t0common::I,t0common::O});at::Tensor empty;for(const auto&name:names){if(name=="mv"&&M!=1)continue;auto Y=run_candidate(name,X,W,Wt,empty,empty,M).contiguous();const float*out=Y.data_ptr<float>();for(int m=0;m<M;++m)for(int o=0;o<t0common::O;++o){int32_t oracle=0;for(int k=0;k<32;++k)oracle+=int32_t(c.wq[o*t0common::I+g*32+k])*int32_t(c.xq[m*t0common::I+g*32+k]);++checks[name];if(double(out[size_t(m)*t0common::O+o])!=double(oracle))++failures[name];}}}}
 bool pass=true;for(const auto&kv:checks){auto f=failures[kv.first];std::cout<<"EXACT_GROUP_DOT_ISOLATION route=torch_"<<kv.first<<" checks="<<kv.second<<" failures="<<f<<" status="<<(f?"FAIL":"PASS")<<"\n";if(kv.first!="mkldnn_linear"&&f)pass=false;}return pass;
}int main(int argc,char**argv) try {
 if(argc==2&&std::string(argv[1])=="--unit"){t0common::verifier_unit_tests();std::cout<<"verifier_unit_tests=PASS (S12 inside/outside boundaries on both signs; NaN; Inf; inconsistent size; exact zero for S=0; negative code and FP16-bit mutations despite zero activation; legacy diagnostic)\n";return 0;}
 large_page_privilege=check_large_page_privilege();configure();at::NoGradGuard no_grad;at::addGlobalCallback(at::RecordFunctionCallback(&on_op));
 std::cout<<"torch="<<TORCH_VERSION<<" intra="<<at::get_num_threads()<<" inter="<<at::get_num_interop_threads()<<" OMP_NUM_THREADS="<<env("OMP_NUM_THREADS")<<" MKL_NUM_THREADS="<<env("MKL_NUM_THREADS")<<" OMP_DYNAMIC="<<env("OMP_DYNAMIC")<<" MKL_DYNAMIC="<<env("MKL_DYNAMIC")<<"\n";
 auto&ctx=at::globalContext();std::cout<<"fp32_precision generic/all="<<at::precision2str(ctx.float32Precision(at::Float32Backend::GENERIC,at::Float32Op::ALL))<<" mkldnn/matmul="<<at::precision2str(ctx.float32Precision(at::Float32Backend::MKLDNN,at::Float32Op::MATMUL))<<" cuda/matmul="<<at::precision2str(ctx.float32Precision(at::Float32Backend::CUDA,at::Float32Op::MATMUL))<<" float32_matmul_precision_enum="<<int(ctx.float32MatmulPrecision())<<"\n";std::cout<<"tf32_onednn="<<ctx.allowTF32OneDNN()<<" tf32_cublas="<<ctx.allowTF32CuBLAS()<<" tf32_cudnn="<<ctx.allowTF32CuDNN()<<" bf16_reduction_cublas="<<int(ctx.allowBF16ReductionCuBLAS())<<" fp16_reduction_cublas="<<int(ctx.allowFP16ReductionCuBLAS())<<" fp16_accumulation_cublas="<<ctx.allowFP16AccumulationCuBLAS()<<" fp16_reduction_cpu="<<ctx.allowFP16ReductionCPU()<<" cpu_bf16_reduction=NO_API_IN_INSTALLED_CONTEXT_H autocast_cpu="<<at::autocast::is_autocast_enabled(at::kCPU)<<" autocast_cuda="<<at::autocast::is_autocast_enabled(at::kCUDA)<<"\n";
 std::vector<std::string> candidates={"mm","matmul","linear","mv"};bool mkldnn_ok=ctx.hasMKLDNN();std::string mkldnn_reason=mkldnn_ok?"available":"at::globalContext().hasMKLDNN()==false";
 bool allpass=true;double overall_abs=0,overall_rel=0;std::map<std::string,std::set<std::string>>dispatch;std::map<std::string,CandidateStats>stats;
 for(int M:{1,4,8,16})for(int fi=0;fi<int(t0common::Fixture::Count);++fi){auto fixture=t0common::Fixture(fi);auto path=std::filesystem::path("T0P/common/data")/("m"+std::to_string(M)+"_"+t0common::fixture_name(fixture)+".bin");auto c=t0common::load_cell(path);std::cout<<"cell M="<<M<<" fixture="<<t0common::fixture_name(c.fixture)<<" canonical_sha256="<<c.sha256<<" source="<<path.string()<<"\n";auto x=tensor([&]{std::vector<float>v(size_t(M)*t0common::I);for(int m=0;m<M;++m)for(int i=0;i<t0common::I;++i)v[m*t0common::I+i]=float(c.xq[m*t0common::I+i])*c.xs[m*t0common::G+i/32];return v;}(),{M,t0common::I});auto w=tensor(unpack_weights(c,false),{t0common::O,t0common::I});auto wt=tensor(unpack_weights(c,true),{t0common::I,t0common::O});bool pages_ok=report_buffer("X_clone_effective",x)&&report_buffer("W_persistent_clone_effective",w)&&report_buffer("Wt_persistent_clone_effective",wt);allpass&=pages_ok;at::Tensor xd,wd;bool this_mkldnn=false;if(mkldnn_ok){try{xd=x.to_mkldnn();wd=w.to_mkldnn();this_mkldnn=true;std::cout<<"buffer=W_mkldnn_packed_effective opaque_mkldnn_layout=yes inspectable_data_ptr=no logical_bytes_accounted="<<size_t(t0common::O)*t0common::I*sizeof(float)<<"\n";}catch(const std::exception&e){mkldnn_ok=false;mkldnn_reason=e.what();}}else std::cout<<"candidate=mkldnn_linear status=NOT_AVAILABLE cause="<<mkldnn_reason<<"\n";
  bool representation=true;auto expected_x=[&]{std::vector<float>v(size_t(M)*t0common::I);for(int m=0;m<M;++m)for(int i=0;i<t0common::I;++i)v[m*t0common::I+i]=float(c.xq[m*t0common::I+i])*c.xs[m*t0common::G+i/32];return v;}();auto expected_w=unpack_weights(c,false);auto expected_wt=unpack_weights(c,true);representation=std::equal(expected_x.begin(),expected_x.end(),x.data_ptr<float>())&&std::equal(expected_w.begin(),expected_w.end(),w.data_ptr<float>())&&std::equal(expected_wt.begin(),expected_wt.end(),wt.data_ptr<float>());std::cout<<"control_representation effective_fp32_X_W_Wt="<<(representation?"PASS":"FAIL")<<" bits=scales_preserved_via_exact_decode\n";
  auto runlist=candidates;if(this_mkldnn)runlist.push_back("mkldnn_linear");for(auto& name:runlist){if(name=="mv"&&M!=1)continue;ops.clear();try{auto y=run_candidate(name,x,w,wt,xd,wd,M);if(name=="mkldnn_linear")y=y.to_dense();y=y.contiguous();dispatch[name].insert(ops.begin(),ops.end());std::vector<float>v(y.data_ptr<float>(),y.data_ptr<float>()+y.numel());auto old=t0common::verify(c,v);auto q=t0common::verify_s12(c,v);bool exact_single=true;if(c.fixture==t0common::Fixture::SingleCoordinate){auto rr=t0common::reference64(c);for(size_t i=0;i<v.size();++i)exact_single&=(double(v[i])==rr.r64[i]);}bool exact_cancel=true;if(c.fixture==t0common::Fixture::ExactCancellation)for(float value:v)exact_cancel&=(value==0.0f);allpass&=q.pass&&representation&&exact_single&&exact_cancel;auto&st=stats[name+"/m="+std::to_string(M)];++st.cells;st.abs=std::max(st.abs,old.max_abs);st.rel=std::max(st.rel,old.max_rel);if(!q.pass||!representation||!exact_single||name=="mkldnn_linear")++st.failed_fixtures;st.error_over_B=std::max(st.error_over_B,q.max_error_over_B);bool numeric_rep_pass=q.pass&&representation&&exact_single&&exact_cancel;std::cout<<"candidate="<<name<<" status="<<(numeric_rep_pass&&name!="mkldnn_linear"?"AVAILABLE_PASS":"NOT_COMPARABLE")<<(numeric_rep_pass&&name!="mkldnn_linear"?"":(name=="mkldnn_linear"?" cause=opaque_MKLDNN_page_policy":" cause=S12_or_representation_or_exact_fixture_failed"))<<" S12_failures="<<q.failures<<" single_coordinate_exact="<<exact_single<<" exact_cancellation_zero="<<exact_cancel<<" max_error_over_B="<<std::setprecision(12)<<q.max_error_over_B<<" old_tolerance_pass="<<old.pass<<" old_tolerance_failures="<<old.failures<<" representation="<<representation<<" ops=";for(auto&o:ops)std::cout<<o<<",";std::cout<<"\n";for(auto&f:q.failed)std::cout<<"S12_FAIL m="<<f.m<<" o="<<f.o<<" r64="<<f.r64<<" y="<<f.y<<" abs="<<f.error<<" S="<<f.S<<" B="<<f.B<<" error_over_B="<<f.error_over_B<<" S_over_abs_r="<<f.S_over_abs_r<<"\n";}catch(const std::exception&e){std::cout<<"candidate="<<name<<" status="<<(name=="mkldnn_linear"?"NOT_COMPARABLE":"UNAVAILABLE")<<" cause="<<e.what()<<"\n";if(name=="mkldnn_linear"){mkldnn_ok=false;mkldnn_reason=e.what();}}}
 }
 for(int M:{1,4,8,16}){auto base=t0common::generate_single_coordinate(M,0);auto w=tensor(unpack_weights(base,false),{t0common::O,t0common::I});auto wt=tensor(unpack_weights(base,true),{t0common::I,t0common::O});std::vector<std::string> names=candidates;if(mkldnn_ok)names.push_back("mkldnn_linear");for(const auto&name:names){if(name=="mv"&&M!=1)continue;std::size_t exact_fail=0,s12_fail=0;double max_ratio=0;for(int pos=0;pos<t0common::I;++pos){auto c=t0common::generate_single_coordinate(M,pos);std::vector<float>xv(size_t(M)*t0common::I);for(int m=0;m<M;++m)for(int i=0;i<t0common::I;++i)xv[m*t0common::I+i]=float(c.xq[m*t0common::I+i])*c.xs[m*t0common::G+i/32];auto x=tensor(xv,{M,t0common::I});auto ew=unpack_weights(c,false);if(!std::equal(xv.begin(),xv.end(),x.data_ptr<float>())||!std::equal(ew.begin(),ew.end(),w.data_ptr<float>()))++exact_fail;at::Tensor xd,wd;if(name=="mkldnn_linear"){xd=x.to_mkldnn();wd=w.to_mkldnn();}ops.clear();auto y=run_candidate(name,x,w,wt,xd,wd,M);if(name=="mkldnn_linear")y=y.to_dense();y=y.contiguous();dispatch[name].insert(ops.begin(),ops.end());std::vector<float>out(y.data_ptr<float>(),y.data_ptr<float>()+y.numel());auto rr=t0common::reference64(c);auto v=t0common::verify_s12(c,out);s12_fail+=v.failures;max_ratio=std::max(max_ratio,v.max_error_over_B);for(size_t i=0;i<out.size();++i)if(double(out[i])!=rr.r64[i])++exact_fail;}std::cout<<"SINGLE_SWEEP candidate="<<name<<" M="<<M<<" positions=512 batches=512 exact_failures="<<exact_fail<<" S12_failures="<<s12_fail<<" max_error_over_B="<<max_ratio<<"\n";if(exact_fail||s12_fail)allpass=false;}}
 bool group_dots_ok=exact_group_dot_isolation();allpass&=group_dots_ok;std::cout<<"mkldnn_linear_final="<<(mkldnn_ok?"NOT_COMPARABLE_PAGE_POLICY":"NOT_AVAILABLE")<<" cause="<<(mkldnn_ok?"ATen opaque MKLDNN tensor has no data_ptr; effective packed-buffer page/allocation policy cannot be inspected under the stated contract":mkldnn_reason)<<"\n";for(auto&kv:stats)std::cout<<"candidate_summary="<<kv.first<<" max_abs="<<kv.second.abs<<" max_rel="<<kv.second.rel<<" failing_fixtures="<<kv.second.failed_fixtures<<"\n";for(auto&kv:dispatch){std::cout<<"dispatch_candidate="<<kv.first<<" observed_ops=";for(auto&s:kv.second)std::cout<<s<<",";std::cout<<"\n";}std::cout<<"overall_numerical_equivalence="<<(allpass?"PASS":"FAIL")<<" benchmark_timed=false\n"<<at::show_config()<<"\n";report_loaded_modules();return allpass?0:3;
}catch(const std::exception&e){std::cerr<<"ERROR: "<<e.what()<<"\n";return 1;}




