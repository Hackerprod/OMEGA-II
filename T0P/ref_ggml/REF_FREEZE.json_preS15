      "repack_m4_m8_m16": "direct upstream ggml_gemm_q4_0_8x8_q8_0 call; supports M>=4 in multiples of 4; M=4,8,16 executed"
    },
    "runtime_features": {
      "avx2": 1,
      "avx_vnni": 1
    },
    "gemm_repack": "Present in source but not selected by ggml_mul_mat CPU graph for these cases",
