{
  "schema": "T0P_COLLECTOR_PAGE_CONTRACT_V1",
  "consumer": "page gate for collector acquisition artifacts",
  "mode": "synthetic QA only; official collection blocked pending AUTHORIZED.json and review",
  "page_query_step": {
    "source": "GetSystemInfo.dwPageSize at runtime",
    "unit": "bytes",
    "required": true,
    "formula": "ceil(((address mod page_size)+logical_bytes)/page_size)",
    "require_valid_pages_equals_queried": true,
    "require_large_pages_equals_queried": true
  },
  "required_regions": ["weights_codes", "weights_scales", "X", "Y", "prepared_activations", "corrective_sums", "scratch", "output"],
  "geometry": {"physical_P_cores": 8, "logical_processors_per_P_core": [0, 2, 4, 6, 8, 10, 12, 14], "E_cores": 16, "m": [1, 4, 8, 16], "workers_8P": 8},
  "qualification": {"G_ggml_min": 0.90, "G_Torch_min": 1.20, "H_KQ_MAC_per_ns_per_worker_min": 33.1, "D_prime_hot_min": 2.0, "N": 31, "warmup": 5, "sample_seconds_min": 2.0, "calibration_seconds_target_min": 2.5},
  "telemetry": {"nominal_interval_seconds": 0.05, "window_seconds_max": 0.1, "windows_per_core_condition_min": 20, "coverage_min": 0.95, "gap_seconds_max": 0.02, "alignment_uncertainty_ms_max": 1.0, "frequency_excursion_fraction_max": 0.03, "energy_unit_joules": 0.00006103515625},
  "states": {"valid_scientific_failure": "FALLIDA_CUALIFICACION", "campaign_line": "CLOSED_Q4_256_THIS_I7", "residency": "NOT_STARTED", "invalid_instrument": "HOLD_INSTRUMENTATION", "invalid_implementation": "INVALID_IMPLEMENTATION", "retry_technical_global_max": 1}
}
